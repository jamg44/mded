{
  // Cmd+Shift+B starts the app in development mode.
  // While it runs: changes in src/ reload automatically; changes in src-tauri/ rebuild and restart.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "mded: app",
      "type": "shell",
      "command": "pnpm app",
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "mded: check",
      "type": "shell",
      "command": "pnpm check && pnpm e2e",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
