{
  "name": "mded",
  "private": true,
  "version": "0.3.0",
  "description": "A native markdown editor with a hybrid live-preview mode. Your file is saved exactly as you wrote it.",
  "license": "MIT",
  "author": "jamg44",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamg44/mded.git"
  },
  "homepage": "https://github.com/jamg44/mded#readme",
  "type": "module",
  "scripts": {
    "app": "tauri dev",
    "app:build": "tauri build",
    "app:install": "tauri build --bundles app && rm -rf /Applications/mded.app && ditto src-tauri/target/release/bundle/macos/mded.app /Applications/mded.app && /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f /Applications/mded.app",
    "web": "vite --port 1430",
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "tsc --noEmit && biome check . && vitest run",
    "fix": "biome check --write ."
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=24"
  }
}
